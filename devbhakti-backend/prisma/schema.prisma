generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  password      String?
  phone         String?
  role          UserRole       @default(DEVOTEE)
  isVerified    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  otp           String?
  otpExpires    DateTime?
  profileImage  String?
  cart          Cart?
  favorites     Favorite[]
  orders        Order[]
  bookings      PoojaBooking[]
  sellerProfile SellerProfile?
  temple        Temple?
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  productId String
  variantId String
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])
}

model Temple {
  id                    String                @id @default(cuid())
  name                  String
  location              String
  fullAddress           String?
  description           String
  history               String?
  image                 String?
  liveUrl               String?               // URL for Live Darshan (YouTube/RTMP)
  channelId             String?               // Permanent YouTube Channel ID (for API lookups)
  heroImages            String[]
  gallery               String[]
  rating                Float                 @default(0)
  reviewsCount          Int                   @default(0)
  category              String
  liveStatus            Boolean               @default(false)
  openTime              String
  phone                 String?
  website               String?
  mapUrl                String?
  viewers               String?
  isLive                Boolean               @default(false)
  userId                String                @unique
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  poojaCommissionRate   Float                 @default(5.0)
  productCommissionRate Float                 @default(10.0)
  templeId              String?               @unique
  slug                  String?               @unique
  isActive              Boolean               @default(true)
  accountHolderName     String?
  accountNumber         String?
  bankName              String?
  ifscCode              String?
  upiId                 String?
  subdomain             String?               @unique
  urlType               String                @default("slug")
  availability          BookingAvailability[]
  events                Event[]
  favorites             Favorite[]
  poojas                Pooja[]
  bookings              PoojaBooking[]
  products              Product[]
  subOrders             SubOrder[]
  user                  User                  @relation(fields: [userId], references: [id])
  pickupLocation        String? 
  ledgerEntries         TempleLedger[]
  updateRequests        TempleUpdateRequest[]
  withdrawals           WithdrawalRequest[]
}

model BookingAvailability {
  id          String   @id @default(cuid())
  templeId    String
  poojaId     String?
  date        String
  maxBookings Int      @default(20)
  isClosed    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  pooja       Pooja?   @relation(fields: [poojaId], references: [id], onDelete: Cascade)
  temple      Temple   @relation(fields: [templeId], references: [id], onDelete: Cascade)

  @@unique([templeId, poojaId, date])
}

model SellerProfile {
  id                    String              @id @default(cuid())
  name                  String
  location              String?
  fullAddress           String?
  description           String?
  image                 String?
  heroImages            String[]
  category              String?
  openTime              String?
  phone                 String?
  website               String?
  isActive              Boolean             @default(true)
  isVerified            Boolean             @default(false)
  userId                String              @unique
  productCommissionRate Float               @default(10.0)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  accountHolderName     String?
  accountNumber         String?
  bankName              String?
  ifscCode              String?
  upiId                 String?
  products              Product[]
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  pickupLocation        String?
  subOrders             SubOrder[]
  ledgerEntries         TempleLedger[]
  withdrawals           WithdrawalRequest[]
}

model TempleUpdateRequest {
  id            String   @id @default(cuid())
  templeId      String
  requestedData Json
  oldData       Json
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  temple        Temple   @relation(fields: [templeId], references: [id], onDelete: Cascade)
}

model Pooja {
  id            String                @id @default(cuid())
  name          String
  category      String
  price         Float
  duration      String
  description   String[]
  time          String
  image         String?
  about         String?
  benefits      String[]
  bullets       String[]
  process       String?
  processSteps  Json?
  
  // New Fields for Master-Template System
  isMaster      Boolean               @default(false) 
  masterPoojaId String?               // Reference to the original pooja if this is a temple copy
  
  templeId      String?               // Optional only for Master Poojas
  templeDetails String?
  packages      Json?
  faqs          Json?
  reviews       Json?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  status        Boolean               @default(true)
  availability  BookingAvailability[]
  favorites     Favorite[]
  temple        Temple?               @relation(fields: [templeId], references: [id])
  bookings      PoojaBooking[]
  masterPooja   Pooja?                @relation("MasterPoojaRelation", fields: [masterPoojaId], references: [id])
  templeCopies  Pooja[]               @relation("MasterPoojaRelation")
}

model Event {
  id          String   @id @default(cuid())
  name        String
  date        String
  description String?
  templeId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  status      Boolean  @default(true)
  temple      Temple   @relation(fields: [templeId], references: [id], onDelete: Cascade)
}

model Banner {
  id        String   @id @default(cuid())
  image     String
  link      String?
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Feature {
  id          String   @id @default(cuid())
  title       String
  description String
  image       String
  icon        String
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  title     String
  subtitle  String
  videoSrc  String
  thumbnail String
  category  String
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  image       String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id              String           @id @default(cuid())
  name            String
  description     String
  category        String
  status          String           @default("pending")
  image           String?
  templeId        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  categoryId      String?
  highlights      String?
  longDescription String?
  shippingInfo    String?          @default("Ships in 24-48 Hours")
  origin          String?          @default("India")
  rating          Float?           @default(4.5)
  weight          Float?           @default(0.5)
  length          Float?           @default(10)
  width           Float?           @default(10)
  height          Float?           @default(10)
  sellerId        String?
  cartItems       CartItem[]
  favorites       Favorite[]
  orderItems      OrderItem[]
  categoryObj     ProductCategory? @relation(fields: [categoryId], references: [id])
  seller          SellerProfile?   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  temple          Temple?          @relation(fields: [templeId], references: [id], onDelete: Cascade)
  variants        ProductVariant[]
}

model ProductVariant {
  id        String     @id @default(cuid())
  name      String
  price     Float
  stock     Int        @default(0)
  image     String?
  productId String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  cartItems CartItem[]
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  templeId  String?
  poojaId   String?
  createdAt DateTime @default(now())
  productId String?
  pooja     Pooja?   @relation(fields: [poojaId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  temple    Temple?  @relation(fields: [templeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, templeId])
  @@unique([userId, poojaId])
  @@unique([userId, productId])
}

model CTACard {
  id         String   @id @default(cuid())
  title      String
  points     String[]
  icon       String
  buttonText String
  buttonLink String
  cardType   String
  active     Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PoojaBooking {
  id               String        @id @default(cuid())
  userId           String
  poojaId          String
  templeId         String
  packageName      String
  packagePrice     Float
  devoteeName      String
  devoteePhone     String
  devoteeEmail     String?
  bookingDate      String?
  address          String?
  specialRequests  String?
  status           BookingStatus @default(BOOKED)
  commissionAmount Float         @default(0)
  netEarning       Float         @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  pooja            Pooja         @relation(fields: [poojaId], references: [id])
  temple           Temple        @relation(fields: [templeId], references: [id])
  user             User          @relation(fields: [userId], references: [id])
}

model Order {
  id              String     @id @default(cuid())
  userId          String
  totalAmount     Float
  status          String     @default("PENDING")
  paymentStatus   String     @default("PENDING")
  paymentMethod   String?
  shippingAddress Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  user            User       @relation(fields: [userId], references: [id])
  subOrders       SubOrder[]
}

model SubOrder {
  id               String         @id @default(cuid())
  orderId          String
  templeId         String?
  totalAmount      Float
  status           String         @default("PENDING")
  commissionAmount Float          @default(0)
  netEarning       Float          @default(0)
  shippingLabel    String?
  shiprocketOrderId String?
  awbCode          String?
  trackingUrl      String?
  courierName      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  sellerId         String?
  items            OrderItem[]
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller           SellerProfile? @relation(fields: [sellerId], references: [id])
  temple           Temple?        @relation(fields: [templeId], references: [id])
}

model OrderItem {
  id          String   @id @default(cuid())
  subOrderId  String
  productId   String
  variantId   String
  variantName String
  price       Float
  quantity    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id])
  subOrder    SubOrder @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
}

model TempleLedger {
  id          String         @id @default(cuid())
  templeId    String?
  amount      Float
  grossAmount Float          @default(0)
  commission  Float          @default(0)
  type        LedgerType
  sourceId    String?
  description String?
  status      LedgerStatus   @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  sellerId    String?
  seller      SellerProfile? @relation(fields: [sellerId], references: [id])
  temple      Temple?        @relation(fields: [templeId], references: [id])
}

model WithdrawalRequest {
  id            String           @id @default(cuid())
  templeId      String?
  amount        Float
  status        WithdrawalStatus @default(PENDING)
  bankDetails   Json?
  transactionId String?
  receiptImage  String?
  adminNotes    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  sellerId      String?
  seller        SellerProfile?   @relation(fields: [sellerId], references: [id])
  temple        Temple?          @relation(fields: [templeId], references: [id])
}

model CommissionSlab {
  id          String   @id @default(cuid())
  minAmount   Float    // Minimum order amount for this slab (e.g., 0, 500, 2000)
  maxAmount   Float?   // Maximum order amount (null for last slab like 4000+)
  platformFee Float    @default(0) // Fixed platform fee (e.g., ₹20)
  percentage  Float    @default(0) // Percentage commission (e.g., 5%)
  slabType    SlabType @default(GLOBAL) // GLOBAL, TEMPLE, or SELLER
  category    CommissionCategory @default(MARKETPLACE) // MARKETPLACE vs POOJA
  targetId    String?  // Specific Temple/Seller ID (null for GLOBAL)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slabType, targetId, category])
}

enum SlabType {
  GLOBAL
  TEMPLE
  SELLER
}

enum CommissionCategory {
  MARKETPLACE
  POOJA
}

enum UserRole {
  ADMIN
  DEVOTEE
  INSTITUTION
  SELLER
}

enum BookingStatus {
  BOOKED
  REJECTED
  COMPLETED
  CANCELLED
  PENDING
}

enum LedgerType {
  MARKETPLACE_EARNING
  POOJA_EARNING
  WITHDRAWAL
}

enum LedgerStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}
